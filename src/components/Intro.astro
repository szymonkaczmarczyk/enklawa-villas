---
import Logo from './Logo.astro';

const lines = [1, 2, 4, 5];
---

<div class="intro" aria-hidden="true" data-intro>
  {lines.map((line) => <span class="intro__line" style={`--line: ${line}`} data-intro-line />)}
  <div class="intro__brand" data-intro-brand>
    <Logo variant="stacked" />
  </div>
</div>

<style>
  .intro {
    display: none;
  }

  :global(.motion.is-intro) .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: grid;
    place-items: center;
    background: var(--color-bg);
  }

  .intro__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--line) * 100% / 6);
    width: 1px;
    background: var(--color-line);
    transform-origin: top;
  }

  .intro__brand :global(.logo) {
    height: clamp(120px, 18vw, 168px);
  }
</style>
