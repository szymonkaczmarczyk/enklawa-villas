---
import Logo from './Logo.astro';
---

<div class="intro" aria-hidden="true" data-intro>
  <div class="intro__brand" data-intro-brand>
    <Logo variant="stacked" />
  </div>
</div>

<style>
  .intro {
    display: none;
  }

  :global(.motion.is-intro) .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: grid;
    place-items: center;
    background: var(--color-bg);
  }

  .intro__brand :global(.logo) {
    height: clamp(120px, 18vw, 168px);
  }
</style>
