---
import { getImage } from 'astro:assets';
import Residence from '../../../components/Residence.astro';
import { properties } from '../../../data/properties';
import { residences } from '../../../data/residences';
import { residenceSchema } from '../../../data/schema';
import { dictionaries, residencePaths } from '../../../i18n';
import Base from '../../../layouts/Base.astro';

export function getStaticPaths() {
  return properties.map((property, index) => ({
    params: { id: property.id },
    props: { property, next: properties[(index + 1) % properties.length] },
  }));
}

const { property, next } = Astro.props;
const lang = 'en';
const t = dictionaries[lang];
const residence = residences[property.id];
const name = property.name[lang];
const location = property.location[lang];
const og = await getImage({ src: property.image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
---

<Base
  lang={lang}
  route={null}
  paths={residencePaths(property.id)}
  image={{ src: og.src, alt: property.alt[lang] }}
  title={`${name}, ${location}: ${t.residence.metaSuffix}`}
  description={`${name}, ${location}. ${residence.description[lang][0]}`}
  schema={residenceSchema(lang, property, residence, og.src)}
>
  <Residence lang={lang} property={property} residence={residence} next={next} />
</Base>
