---
import { Picture } from 'astro:assets';
import baltyk from '../assets/properties/baltyk.jpg';
import Button from '../components/Button.astro';
import { dictionaries, routes } from '../i18n';
import Base from '../layouts/Base.astro';

const t = dictionaries.pl;
---

<Base
  lang="pl"
  route={null}
  title="Nie znaleziono strony | Enklawa Villas"
  description="Ten adres nie istnieje. Wróć na stronę główną Enklawa Villas albo umów rozmowę z kuratorem."
  noindex
>
  <section class="missing" aria-labelledby="missing-title">
    <Picture
      src={baltyk}
      alt=""
      formats={['avif', 'webp']}
      widths={[960, 1600, 1920]}
      sizes="100vw"
      quality={60}
      loading="eager"
      fetchpriority="high"
      class="missing__image"
    />
    <div class="missing__inner container">
      <p class="missing__code t-caps">404</p>
      <h1 class="t-h1" id="missing-title">Tego adresu nie ma w naszym portfolio.</h1>
      <p class="t-lead">Strona mogła zostać przeniesiona albo link jest niepełny. Wróć na stronę główną albo umów rozmowę z kuratorem.</p>
      <div class="missing__actions">
        <Button variant="solid" href={routes.home.pl} icon="arrowLeft" iconFirst>Wróć na stronę główną</Button>
        <Button variant="glass" data-dossier-open>{t.cta}</Button>
      </div>
      <p class="missing__alt" lang="en">
        This address is not in our portfolio.{' '}
        <a class="text-link" href={routes.home.en}>Go to the English home page</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .missing {
    position: relative;
    display: grid;
    min-height: 100svh;
    isolation: isolate;
    overflow: clip;
  }

  .missing :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .missing :global(.missing__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 55%;
  }

  .missing::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to right, rgb(18 19 22 / 0.9) 0, rgb(18 19 22 / 0.55) 60%, rgb(18 19 22 / 0.35) 100%),
      linear-gradient(to top, var(--color-bg) 0, rgb(18 19 22 / 0) 50%);
  }

  .missing__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-5);
    padding-top: calc(var(--header-height) + var(--space-8));
    padding-bottom: var(--space-10);
  }

  .missing__inner h1 {
    max-width: 13em;
  }

  .missing__code {
    color: var(--color-accent);
  }

  .missing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .missing__alt {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }
</style>
